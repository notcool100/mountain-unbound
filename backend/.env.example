DATABASE_URL="postgresql://user:password@host:5432/db_name?schema=public"

PORT=4000
NODE_ENV=development

JWT_SECRET=change-me-to-a-long-random-string-before-deploying
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Directory (relative to the process cwd, or absolute) where uploaded images/video are stored.
# In production this must be a persistent volume, or uploads are lost on redeploy.
UPLOADS_DIR=uploads
MAX_IMAGE_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=300
